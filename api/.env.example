# ===========================
# API Server Configuration
# ===========================

# Node environment: development | production
# default: development
NODE_ENV=development

# Server port (default: 3000)
PORT=3000

# ===========================
# Database Configuration
# ===========================

# MongoDB connection URI
# Development: mongodb://localhost:27017/managelog
# Production: mongodb+srv://user:password@cluster.mongodb.net/managelog
MONGODB_URI=mongodb://localhost:27017/managelog

# ===========================
# JWT Configuration
# ===========================

# JWT Access Token Secret (minimum 32 characters for production!)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Development: can use default value
# Production: REQUIRED, must be 32+ characters
JWT_SECRET=dev-secret-key-not-for-production-12345

# JWT Refresh Token Secret (minimum 32 characters for production!)
# Different from JWT_SECRET for better security
# Production: REQUIRED, must be 32+ characters
JWT_REFRESH_SECRET=dev-refresh-secret-key-not-for-production-12345

# Token expiration times
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# CORS Configuration
# ===========================

# Allowed Origins (comma-separated for multiple origins)
# Development: auto-detects localhost:3000, localhost:5173, localhost:8080
# Production: must specify exact frontend URL
# Example: https://app.managelog.ru
# Note: Must match the domain where your frontend is hosted
ALLOWED_ORIGINS=https://app.managelog.ru
